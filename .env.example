# ---- Vigil configuration (copy to .env; NEVER commit .env) ----

# Database. SQLite needs nothing else; Postgres via docker-compose uses the
# POSTGRES_PASSWORD below.
VIGIL_DATABASE_URL=sqlite:///vigil.db
POSTGRES_PASSWORD=change-me-strong-password

# Private API auth token (any long random string; required outside debug).
VIGIL_API_TOKEN=change-me-long-random-token

# Providers per capability: synthetic | stooq | edgar | <your adapter>
VIGIL_PROVIDER_PRICE=synthetic
VIGIL_PROVIDER_FUNDAMENTALS=synthetic
VIGIL_PROVIDER_ESTIMATES=synthetic
VIGIL_PROVIDER_NEWS=synthetic
VIGIL_PROVIDER_MACRO=synthetic
# Options-derived data has no default provider; leave empty to mark unavailable.
VIGIL_PROVIDER_OPTIONS=

# SEC EDGAR fair-access User-Agent, format: "Your Name you@example.com"
VIGIL_EDGAR_USER_AGENT=

# LLM narrative synthesis (optional; deterministic templates used when unset).
VIGIL_ANTHROPIC_API_KEY=
VIGIL_LLM__ENABLED=false
VIGIL_LLM__MODEL=claude-sonnet-5

# Notification channels (all optional; in-app always works).
VIGIL_WEBHOOK_URL=
VIGIL_SMTP_HOST=
VIGIL_SMTP_PORT=587
VIGIL_SMTP_USER=
VIGIL_SMTP_PASSWORD=
VIGIL_SMTP_FROM=
VIGIL_SMTP_TO=

# Research configuration overrides (all optional; defaults documented in
# backend/src/vigil/config.py). Nested fields use double underscores.
# VIGIL_BASE_CURRENCY=GBP
# VIGIL_UNIVERSE__MIN_MARKET_CAP=250000000
# VIGIL_UNIVERSE__MIN_PRICE=1.0
# VIGIL_UNIVERSE__MIN_MEDIAN_DAILY_TRADED_VALUE=1000000
# VIGIL_UNIVERSE__EXCLUDED_INDUSTRIES=["Tobacco","Defence"]
# VIGIL_GATES__MIN_CONFIDENCE=5.5
# VIGIL_GATES__MIN_OPPORTUNITY=6.5
# VIGIL_GATES__MIN_REWARD_RISK=2.0
# VIGIL_RISK_POLICY__RISK_TOLERANCE=balanced
# VIGIL_RISK_POLICY__MAX_POSITION_EXPOSURE_PCT=10
# VIGIL_RISK_POLICY__MAX_SECTOR_EXPOSURE_PCT=25
# VIGIL_SCAN__SCAN_FREQUENCY=eod
# VIGIL_ALERT_POLICY__COOLDOWN_DAYS=5
