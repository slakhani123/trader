# REAL DATA — Tiingo route (free API key; US prices with proper corporate
# actions + FX; fundamentals still from SEC EDGAR).
# Use this when stooq is blocked or rate-limited on your network.
#
# Setup (from the backend folder):
#   1. create a free account at https://www.tiingo.com -> copy your API token
#      (Account -> API -> Token)
#   2. copy this file to .env            (Windows:  Copy-Item env.tiingo.example .env)
#   3. paste your token + your name/email below
#   4. IMPORTANT: Tiingo has no index symbols — in universe.yml replace the
#      ^SPX benchmark row with the SPY ETF row:
#        - {ticker: SPY, name: "S&P 500 ETF", market: US, sector: "", security_type: index}
#      and remove (or comment out with #) the ^UKX row and the UK companies —
#      Tiingo's free tier is US-only. UK coverage comes with EODHD.
#   5. delete vigil.db, then:  .venv\Scripts\vigil seed   and   .venv\Scripts\vigil scan
#
# Free-tier limits (comfortable for a personal universe): ~1000 requests/day
# and a monthly unique-symbol cap — keep the universe under ~50 names.

VIGIL_DEBUG=true

VIGIL_TIINGO_API_KEY=paste-your-token-here

VIGIL_PROVIDER_REFERENCE=static
VIGIL_UNIVERSE_FILE=universe.yml

# Prices + corporate actions + FX from Tiingo.
VIGIL_PROVIDER_PRICE=tiingo
VIGIL_PROVIDER_MACRO=tiingo

# US financial statements from SEC EDGAR (free). REQUIRED: your name+email.
VIGIL_PROVIDER_FUNDAMENTALS=edgar
VIGIL_EDGAR_USER_AGENT=Your Name your.email@example.com

# No free source for these; engines abstain honestly. EODHD fills them later.
VIGIL_PROVIDER_ESTIMATES=
VIGIL_PROVIDER_NEWS=
