# REAL DATA — free route (Stooq prices + SEC EDGAR US financials).
#
# Setup (from the backend folder):
#   1. copy this file to .env            (Windows:  Copy-Item env.realdata.example .env)
#   2. copy universe.example.yml to universe.yml and edit your company list
#   3. put YOUR name and email on the EDGAR line below (SEC requires it)
#   4. re-seed:  .venv\Scripts\vigil seed        then:  .venv\Scripts\vigil scan
#
# Starting fresh? Delete vigil.db first so demo data and real data don't mix.

VIGIL_DEBUG=true

# Universe comes from your editable list, not a vendor screener.
VIGIL_PROVIDER_REFERENCE=static
VIGIL_UNIVERSE_FILE=universe.yml

# Prices + FX + VIX from stooq (free, keyless).
VIGIL_PROVIDER_PRICE=stooq
VIGIL_PROVIDER_MACRO=stooq

# US company financial statements from SEC EDGAR (free).
# REQUIRED by the SEC's fair-access policy: your real name and email.
VIGIL_PROVIDER_FUNDAMENTALS=edgar
VIGIL_EDGAR_USER_AGENT=Your Name your.email@example.com

# No free, terms-compatible source exists for these — left off. The related
# engines abstain and confidence is honestly lower. Enable EODHD to fill them.
VIGIL_PROVIDER_ESTIMATES=
VIGIL_PROVIDER_NEWS=

# Several large UK companies trade below £1 — don't exclude them by price.
VIGIL_UNIVERSE__MIN_PRICE=0.2
