# REAL DATA — EODHD route (paid, ~£20/month; https://eodhd.com).
# Full coverage: prices WITH splits/dividends, UK + US financial statements,
# analyst estimates and targets, news, earnings calendar, FX.
#
# Setup (from the backend folder):
#   1. subscribe at eodhd.com ("EOD Historical Data" plan or above; the
#      fundamentals feed needs their All-In-One/fundamentals add-on)
#   2. copy this file to .env            (Windows:  Copy-Item env.eodhd.example .env)
#   3. paste your API token below
#   4. copy universe.example.yml to universe.yml and edit your company list
#   5. delete vigil.db, then:  .venv\Scripts\vigil seed   and   .venv\Scripts\vigil scan
#
# NOTE: this adapter is built against EODHD's documented API but was not
# verified against the live service during development (see docs/LIMITATIONS.md).
# If a fetch errors on first use, check Data Health for the message.

VIGIL_DEBUG=true

VIGIL_EODHD_API_KEY=paste-your-token-here

VIGIL_PROVIDER_REFERENCE=static
VIGIL_UNIVERSE_FILE=universe.yml

VIGIL_PROVIDER_PRICE=eodhd
VIGIL_PROVIDER_FUNDAMENTALS=eodhd
VIGIL_PROVIDER_ESTIMATES=eodhd
VIGIL_PROVIDER_NEWS=eodhd
VIGIL_PROVIDER_MACRO=eodhd

VIGIL_UNIVERSE__MIN_PRICE=0.2
